function applyPartTimeSalaryDataFormat_(sheet, table, rowCount, ss) {
  if (!rowCount) return;
  const spreadsheet = ss || getSs();
  const regularSalarySheet = getOptionalSheet_(SHEETS.salary, spreadsheet);
  const firstDataRow = table.headerRow + 1;
  const normalRowCount = Math.max(rowCount - 1, 0);
  const totalRow = firstDataRow + rowCount - 1;

  if (regularSalarySheet) {
    const regularTable = getFlexibleTable(regularSalarySheet, "ชื่อ");
    const regularFirstDataRow = regularTable.headerRow + 1;
    if (normalRowCount) {
      regularSalarySheet.getRange(regularFirstDataRow, 1, 1, 8)
        .copyFormatToRange(sheet, 1, 8, firstDataRow, firstDataRow + normalRowCount - 1);
      regularSalarySheet.getRange(regularFirstDataRow, 12)
        .copyFormatToRange(sheet, 9, 9, firstDataRow, firstDataRow + normalRowCount - 1);
      sheet.setRowHeights(firstDataRow, normalRowCount, regularSalarySheet.getRowHeight(regularFirstDataRow));
    }

    let regularTotalRow = regularTable.headerRow + regularTable.rows.length;
    regularTable.rows.forEach((row, index) => {
      if (clean(row[0]) === "รวมทั้งหมด") regularTotalRow = regularTable.headerRow + 1 + index;
    });
    regularSalarySheet.getRange(regularTotalRow, 1, 1, 8)
      .copyFormatToRange(sheet, 1, 8, totalRow, totalRow);
    regularSalarySheet.getRange(regularTotalRow, 12)
      .copyFormatToRange(sheet, 9, 9, totalRow, totalRow);
    sheet.setRowHeight(totalRow, regularSalarySheet.getRowHeight(regularTotalRow));
  } else {
    sheet.getRange(totalRow, 1, 1, 9)
      .setBackground("#174E3B")
      .setFontColor("#FFFFFF")
      .setFontWeight("bold");
  }

  sheet.getRange(firstDataRow, 2, rowCount, 8).setNumberFormat("#,##0.##");
}

function ensurePartTimeSalaryRows_(sheet, table, neededRows) {
  const requiredLastRow = table.headerRow + neededRows;
  if (sheet.getMaxRows() < requiredLastRow) {
    sheet.insertRowsAfter(sheet.getMaxRows(), requiredLastRow - sheet.getMaxRows());
  }
  if (table.rows.length > neededRows) {
    sheet.getRange(table.headerRow + 1 + neededRows, 1, table.rows.length - neededRows, 9).clearContent();
  }
}

function findEmployeeRowByName_(sheet, headerRow, name) {
  const values = sheet.getDataRange().getValues();
  for (let index = headerRow; index < values.length; index++) {
    const first = clean(values[index][0]);
    if (first.indexOf("💡") === 0 || first.indexOf("📋") === 0) break;
    if (clean(values[index][1]) === clean(name)) return index + 1;
  }
  return 0;
}

function moveSheetAfter_(ss, sheet, afterSheet) {
  if (!sheet || !afterSheet || sheet.getSheetId() === afterSheet.getSheetId()) return;
  const sheetCount = ss.getSheets().length;
  const currentIndex = sheet.getIndex();
  const afterIndex = afterSheet.getIndex();
  // If the moving sheet is before the target, removing it shifts the target
  // one place to the left. Clamp the result because moveActiveSheet rejects a
  // position outside the current sheet count.
  const requestedIndex = currentIndex < afterIndex ? afterIndex : afterIndex + 1;
  const targetIndex = Math.max(1, Math.min(requestedIndex, sheetCount));
  if (currentIndex === targetIndex) return;
  const activeSheet = ss.getActiveSheet();
  ss.setActiveSheet(sheet);
  ss.moveActiveSheet(targetIndex);
  if (activeSheet && activeSheet.getSheetId() !== sheet.getSheetId()) ss.setActiveSheet(activeSheet);
}

function getMonthPeriod(date) {
  const monthStart = new Date(date.getFullYear(), date.getMonth(), 1);
  const monthEnd = new Date(date.getFullYear(), date.getMonth() + 1, 0);
  return {
    start: Utilities.formatDate(monthStart, TIMEZONE, "yyyy-MM-dd"),
    end: Utilities.formatDate(monthEnd, TIMEZONE, "yyyy-MM-dd"),
    label: THAI_MONTH_NAMES[date.getMonth()] + " " + (date.getFullYear() + 543)
  };
}

function calculateApprovedLeaveUsage(ss) {
  const sheet = getSheet(SHEETS.leaves, ss);
  const table = getFlexibleTable(sheet, "วันที่ยื่น");
  const usage = {};

  table.rows.forEach(row => {
    const name = clean(row[1]);
    const type = clean(row[2]);
    const days = Number(row[5]) || 1;
    const status = clean(row[7]);
    if (!name || !type || status !== "อนุมัติ") return;
    if (!usage[name]) usage[name] = {};
    usage[name][type] = (Number(usage[name][type]) || 0) + days;
  });

  return usage;
}

function doOT(data) {
  requireFields(data, ["name", "date", "start", "end"]);
  const sheet = getSheet(SHEETS.ot);
  ensureTableHeaderColumn(sheet, "วันที่", "เวลาที่ยื่น");
  const hours = Number(data.hours) || calculateHours(data.start, data.end);
  const rate = Number(data.rate) || getEmployeeOtRate(data.name);
  if (!rate) throw new Error("Missing OT rate for employee: " + clean(data.name));
  const dateKey = normalizeDateKey(data.date);
  const isHoliday = checkHoliday(dateKey);
  const submittedAt = Utilities.formatDate(new Date(), TIMEZONE, "dd/MM/yyyy HH:mm:ss");

  const row = writeDataRowAtTop(sheet, "วันที่", [
    toDisplayDate(dateKey),
    clean(data.name),
    clean(data.start),
    clean(data.end),
    hours,
    rate,
    hours * rate,
    isHoliday ? "วันหยุดนักขัตฤกษ์" : "วันธรรมดา",
    "รออนุมัติ",
    submittedAt
  ]);
  applyValidationFromNearbyRow(sheet, row, 9);
  sortMonthlyRequestRowsNewestFirst_(sheet, getFlexibleTable(sheet, OT_FILTER.firstHeader), OT_FILTER);
  refreshMonthlyRequestFilter_(sheet, OT_FILTER);

  return { status: "ok" };
}

function doCancelOT(data) {
  const row = Number(data.row);
  if (!row) throw new Error("Missing OT row");
  const sheet = getSheet(SHEETS.ot);
  const table = getFlexibleTable(sheet, "วันที่");
  if (row <= table.headerRow) throw new Error("Invalid OT row");
  if (clean(sheet.getRange(row, 2).getValue()) !== clean(data.name)) throw new Error("Employee name does not match row");
  sheet.getRange(row, 9).setValue("ยกเลิก");
  return { status: "ok" };
}

function checkHoliday(dateValue) {
  const target = normalizeDateKey(dateValue);
  if (!target) return false;
  const data = getHolidaysData().items;
