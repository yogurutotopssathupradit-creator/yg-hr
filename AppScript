}

function isEmployeeScheduleConfigEdit_(e) {
  if (!e || !e.range) return true;
  const sheet = e.range.getSheet();
  const values = sheet.getDataRange().getValues();
  const headerIndex = findRow(values, "รหัส", 0);
  if (headerIndex < 0) return true;
  const headers = getHeaderMap(values[headerIndex]);
  const watchedColumns = [
    2,
    Number(headers["วันหยุดประจำ"]) + 1,
    Number(headers["ตำแหน่งหลัก"]) + 1,
    Number(headers["กะหลัก"]) + 1
  ].filter(Boolean);
  const firstCol = e.range.getColumn();
  const lastCol = firstCol + e.range.getNumColumns() - 1;
  return watchedColumns.some(col => col >= firstCol && col <= lastCol);
}

function syncMonthlySalary(targetDate, ss) {
  // Installable time-based triggers pass an event object as the first argument.
  // Only treat an actual, valid Date as an explicit salary period.
  const date = targetDate instanceof Date && !isNaN(targetDate.getTime())
    ? targetDate
    : new Date();
  const period = getMonthPeriod(date);
  const employees = getEmployeesData(ss).employees.filter(emp => emp.employmentType === "fullTime");
  const checkins = calculateMonthlyCheckins(period.start, period.end, ss);
  const leaves = calculateMonthlyLeaveSummary(period.start, period.end, ss);
  const ot = calculateMonthlyOtSummary(period.start, period.end, ss);
  const currentManual = getCurrentSalaryManualValues(ss);
  const sheet = getSheet(SHEETS.salary, ss);
  const table = getFlexibleTable(sheet, "ชื่อ");
  const rows = [];
  const totals = {
    salary: 0,
    workDays: 0,
    paidLeave: 0,
    unpaidLeave: 0,
    normalPay: 0,
    holidayWorked: 0,
    holidayExtra: 0,
    ot: 0,
    diligence: 0,
    incentive: 0,
    net: 0
  };

  employees.forEach(emp => {
    const salary = parseMoney(emp.salary);
    const dailyRate = salary / 30;
    const name = emp.name;
    const workDays = Number((checkins[name] && checkins[name].workDays) || 0);
    const holidayWorked = Number((checkins[name] && checkins[name].holidayWorked) || 0);
    const paidLeave = Number((leaves[name] && leaves[name].paid) || 0);
    const unpaidLeave = Number((leaves[name] && leaves[name].unpaid) || 0);
    const otTotal = Number((ot[name] && ot[name].total) || 0);
    const manual = currentManual[name] || {};
    const diligence = Number(manual.diligence) || 0;
    const incentive = Number(manual.incentive) || 0;
    const normalPay = Math.max(Math.round((dailyRate * workDays) - (unpaidLeave * 400)), 0);
    const holidayExtra = holidayWorked * 400;
    const net = normalPay + holidayExtra + otTotal + diligence + incentive;

    totals.salary += salary;
    totals.workDays += workDays;
    totals.paidLeave += paidLeave;
    totals.unpaidLeave += unpaidLeave;
    totals.normalPay += normalPay;
    totals.holidayWorked += holidayWorked;
    totals.holidayExtra += holidayExtra;
    totals.ot += otTotal;
    totals.diligence += diligence;
    totals.incentive += incentive;
    totals.net += net;

    rows.push([
      name,
      salary,
      workDays,
      paidLeave,
      unpaidLeave,
      normalPay,
      holidayWorked,
      holidayExtra,
      otTotal,
      diligence,
      incentive,
      net
    ]);
  });

  rows.push([
    "รวมทั้งหมด",
    totals.salary,
    totals.workDays,
    totals.paidLeave,
    totals.unpaidLeave,
    totals.normalPay,
    totals.holidayWorked,
    totals.holidayExtra,
    totals.ot,
    totals.diligence,
    totals.incentive,
    totals.net
  ]);

  sheet.getRange(table.headerRow, 2).setValue(period.label + " เงินเดือนฐาน");
  sheet.getRange(table.headerRow, 8).setValue("ค่าแรงพิเศษ (400 บาท/วัน)");
  ensureSalaryRows(sheet, table, rows.length);
  sheet.getRange(table.headerRow + 1, 1, rows.length, 12).setValues(rows);
  const partTimeResult = syncMonthlyPartTimeSalary(date, ss);
  return {
    status: "ok",
    month: period.label,
    rows: rows.length,
    partTimeRows: partTimeResult.rows
  };
}

function runMonthlySalaryNow() {
  return syncMonthlySalary();
}

function syncMonthlyPartTimeSalary(targetDate, ss) {
  const date = targetDate instanceof Date && !isNaN(targetDate.getTime())
    ? targetDate
    : new Date();
  const period = getMonthPeriod(date);
  const employees = getEmployeesData(ss).employees.filter(emp => emp.employmentType === "partTime");
  const workedHours = calculateMonthlyWorkedHours(period.start, period.end, ss);
  const ot = calculateMonthlyOtSummary(period.start, period.end, ss);
  const sheet = ensurePartTimeSalarySheet_(ss);
  const table = getFlexibleTable(sheet, "ชื่อ");
  const rows = [];
  const totals = {
    clockedHours: 0,
    normalHours: 0,
    normalPay: 0,
    otHours: 0,
    otPay: 0,
    net: 0
  };

  employees.forEach(emp => {
    const clockedHours = Number(workedHours[emp.name]) || 0;
    const otHours = Number((ot[emp.name] && ot[emp.name].hours) || 0);
    // Check-in/out covers the whole shift. Remove approved OT hours so those
    // hours are paid once at the OT rate instead of at both rates.
    const normalHours = roundNumber_(Math.max(clockedHours - otHours, 0), 2);
    const normalPay = roundNumber_(normalHours * emp.hourlyRate, 2);
    const otPay = roundNumber_(Number((ot[emp.name] && ot[emp.name].total) || 0), 2);
    const net = roundNumber_(normalPay + otPay, 2);

    totals.clockedHours += clockedHours;
    totals.normalHours += normalHours;
    totals.normalPay += normalPay;
    totals.otHours += otHours;
    totals.otPay += otPay;
    totals.net += net;

    rows.push([
      emp.name,
      emp.hourlyRate,
      roundNumber_(clockedHours, 2),
      normalHours,
      normalPay,
      roundNumber_(otHours, 2),
      emp.otRate,
      otPay,
      net
    ]);
  });

  rows.push([
    "รวมทั้งหมด",
    "",
    roundNumber_(totals.clockedHours, 2),
    roundNumber_(totals.normalHours, 2),
    roundNumber_(totals.normalPay, 2),
    roundNumber_(totals.otHours, 2),
    "",
    roundNumber_(totals.otPay, 2),
    roundNumber_(totals.net, 2)
  ]);

  sheet.getRange(table.headerRow - 1, 1).setValue("เดือน:");
  sheet.getRange(table.headerRow - 1, 2).setValue(period.label);
  ensurePartTimeSalaryRows_(sheet, table, rows.length);
  sheet.getRange(table.headerRow + 1, 1, rows.length, 9).setValues(rows);
  applyPartTimeSalaryDataFormat_(sheet, table, rows.length, ss);
  return { status: "ok", month: period.label, rows: rows.length };
}

function calculateMonthlyCheckins(start, end, ss) {
  const sheet = getSheet(SHEETS.checkins, ss);
  const table = getFlexibleTable(sheet, "วันที่");
  const byName = {};
  table.rows.forEach(row => {
    const dateKey = normalizeDateKey(row[0]);
    if (!dateKey || dateKey < start || dateKey > end) return;
    if (clean(row[2]) !== "เช็คอิน") return;
    const name = clean(row[1]);
    if (!name) return;
    if (!byName[name]) byName[name] = { dates: {}, holidayDates: {} };
    byName[name].dates[dateKey] = true;
    if (checkHoliday(dateKey)) byName[name].holidayDates[dateKey] = true;
  });

  const summary = {};
  Object.keys(byName).forEach(name => {
    summary[name] = {
      workDays: Object.keys(byName[name].dates).length,
      holidayWorked: Object.keys(byName[name].holidayDates).length
    };
  });
  return summary;
}

function calculateMonthlyWorkedHours(start, end, ss) {
  const sheet = getSheet(SHEETS.checkins, ss);
  const table = getFlexibleTable(sheet, "วันที่");
  const events = {};

  table.rows.forEach(row => {
    const dateKey = normalizeDateKey(row[0]);
    const name = clean(row[1]);
    const type = clean(row[2]);
    const minute = toMinuteOfDay_(row[3]);
    if (!dateKey || dateKey < start || dateKey > end || !name || minute === null) return;
    if (type !== "เช็คอิน" && type !== "เช็คเอาท์") return;
    const key = name + "\n" + dateKey;
    if (!events[key]) events[key] = [];
    events[key].push({ name, type, minute });
  });

  const hours = {};
  Object.keys(events).forEach(key => {
    const dayEvents = events[key].sort((a, b) => a.minute - b.minute);
    let checkinMinute = null;
    dayEvents.forEach(event => {
      if (event.type === "เช็คอิน") {
        if (checkinMinute === null) checkinMinute = event.minute;
        return;
      }
      if (checkinMinute === null || event.minute <= checkinMinute) return;
      hours[event.name] = (Number(hours[event.name]) || 0) + ((event.minute - checkinMinute) / 60);
      checkinMinute = null;
    });
  });

  Object.keys(hours).forEach(name => {
    hours[name] = roundNumber_(hours[name], 2);
  });
  return hours;
}

function calculateMonthlyLeaveSummary(start, end, ss) {
  const sheet = getSheet(SHEETS.leaves, ss);
  const table = getFlexibleTable(sheet, "วันที่ยื่น");
  const summary = {};
  table.rows.forEach(row => {
    const name = clean(row[1]);
    const type = clean(row[2]);
    const dateKey = normalizeDateKey(row[3]);
    const status = clean(row[7]);
    if (!name || status !== "อนุมัติ" || !dateKey || dateKey < start || dateKey > end) return;
    if (!summary[name]) summary[name] = { paid: 0, unpaid: 0 };
    const days = Number(row[5]) || 1;
    if (type === "ลาไม่รับเงิน") summary[name].unpaid += days;
    else summary[name].paid += days;
  });
  return summary;
}

function calculateMonthlyOtSummary(start, end, ss) {
  const sheet = getSheet(SHEETS.ot, ss);
  const table = getFlexibleTable(sheet, "วันที่");
  const summary = {};
  table.rows.forEach(row => {
    const name = clean(row[1]);
    const dateKey = normalizeDateKey(row[0]);
    const status = clean(row[8]);
    if (!name || status !== "อนุมัติ" || !dateKey || dateKey < start || dateKey > end) return;
    if (!summary[name]) summary[name] = { hours: 0, total: 0 };
    summary[name].hours += Number(row[4]) || 0;
    summary[name].total += Number(row[6]) || 0;
  });
  return summary;
}

function getCurrentSalaryManualValues(ss) {
  const sheet = getSheet(SHEETS.salary, ss);
  const table = getFlexibleTable(sheet, "ชื่อ");
  const values = {};
  table.rows.forEach(row => {
