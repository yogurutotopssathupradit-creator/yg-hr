  }

  const values = sheet.getDataRange().getValues();
  const existingHeader = findRow(values, "ชื่อ", 0);
  if (existingHeader >= 0 && existingHeader + 1 !== headerRow) {
    sheet.getRange(existingHeader + 1, 1, Math.max(sheet.getLastRow() - existingHeader, 1), 9).clearContent();
  }

  if (sheet.getMaxColumns() < 9) sheet.insertColumnsAfter(sheet.getMaxColumns(), 9 - sheet.getMaxColumns());
