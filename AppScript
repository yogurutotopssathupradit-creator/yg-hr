function setupMonthlyRequestTable_(sheet, config) {
  const table = getFlexibleTable(sheet, config.firstHeader);
  sortMonthlyRequestRowsNewestFirst_(sheet, table, config);
  setupMonthlyRequestSelector_(sheet, config);
  refreshMonthlyRequestFilter_(sheet, config);
  return { status: "ok", rows: table.rows.length };
}

function setupMonthlyRequestSelector_(sheet, config) {
  const options = [config.allLabel].concat(getMonthlyRequestOptions_(sheet, config));
  const current = clean(sheet.getRange(config.selectorCell).getDisplayValue());
  const legacy = clean(sheet.getRange(config.legacySelectorCell).getDisplayValue());
  const selected = options.indexOf(current) >= 0
    ? current
    : options.indexOf(legacy) >= 0
      ? legacy
      : getMonthPeriod(new Date()).label;

  if (config.legacySelectorCell !== config.labelCell) {
    sheet.getRange(config.legacySelectorCell)
      .clearContent()
      .clearDataValidations()
      .setBackground(null)
      .setFontColor(null)
      .setFontWeight("normal");
  }

  sheet.getRange(config.labelCell)
    .setValue("เลือกเดือน")
    .setFontWeight("bold")
    .setBackground("#E6F4EA")
    .setFontColor("#174E3B");
  sheet.getRange(config.selectorCell)
    .setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList(options, true)
      .setAllowInvalid(false)
      .build())
    .setValue(selected)
    .setBackground("#E6F4EA")
    .setFontColor("#174E3B");
}

function refreshMonthlyRequestFilter_(sheet, config) {
  const selected = clean(sheet.getRange(config.selectorCell).getDisplayValue()) || config.allLabel;
  const table = getFlexibleTable(sheet, config.firstHeader);
  ensureMonthlyRequestFilter_(sheet, table, config);
  applyMonthlyRequestFilter_(sheet, config, selected);
}

function applyMonthlyRequestFilter_(sheet, config, selectedValue) {
  const selected = clean(selectedValue || sheet.getRange(config.selectorCell).getDisplayValue());
  const filter = sheet.getFilter();
  if (!filter) return;
  if (!selected || selected === config.allLabel) {
    filter.removeColumnFilterCriteria(config.dateColumn);
    return;
  }

  const period = parseThaiMonthLabel_(selected);
  if (!period) return;
  const table = getFlexibleTable(sheet, config.firstHeader);
  const firstDataRow = table.headerRow + 1;
  const columnLetter = columnToLetter_(config.dateColumn);
  const formula = "=AND($" + columnLetter + firstDataRow + ">=DATE(" + period.year + "," + period.month + ",1)," +
    "$" + columnLetter + firstDataRow + "<DATE(" + period.nextYear + "," + period.nextMonth + ",1))";
  filter.setColumnFilterCriteria(config.dateColumn, SpreadsheetApp.newFilterCriteria()
    .whenFormulaSatisfied(formula)
    .build());
}

function getMonthlyRequestOptions_(sheet, config) {
  const table = getFlexibleTable(sheet, config.firstHeader);
  const dates = table.rows.length
    ? sheet.getRange(table.headerRow + 1, config.dateColumn, table.rows.length, 1).getDisplayValues()
    : [];
  const months = {};
  dates.forEach(row => {
    const date = parseDate(row[0]);
    if (!date) return;
    const key = Utilities.formatDate(date, TIMEZONE, "yyyy-MM");
    months[key] = getMonthPeriod(date).label;
  });
  const now = new Date();
  months[Utilities.formatDate(now, TIMEZONE, "yyyy-MM")] = getMonthPeriod(now).label;
  return Object.keys(months).sort().reverse().map(key => months[key]);
}

function sortMonthlyRequestRowsNewestFirst_(sheet, table, config) {
  if (!table.rows.length) return;
  const firstDataRow = table.headerRow + 1;
  const range = sheet.getRange(firstDataRow, 1, table.rows.length, config.columnCount);
  const values = range.getValues();
  const displayed = range.getDisplayValues();
  const dateIndex = config.dateColumn - 1;
  const rows = values.map((row, index) => {
    const normalized = row.slice();
    normalized[dateIndex] = parseDate(displayed[index][dateIndex]) || row[dateIndex];
    if (config === LEAVE_FILTER) normalized[4] = parseDate(displayed[index][4]) || row[4];
    return {
      values: normalized,
      date: normalizeDateKey(displayed[index][dateIndex]),
      submitted: config === LEAVE_FILTER
        ? parseDateTimeValue(displayed[index][0])
        : parseDateTimeValue(displayed[index][9]),
      time: config === OT_FILTER ? timeSortValue_(displayed[index][2]) : 0
    };
  });

  rows.sort((a, b) => {
    const dateCompare = b.date.localeCompare(a.date);
    if (dateCompare) return dateCompare;
    const submittedCompare = b.submitted - a.submitted;
    if (submittedCompare) return submittedCompare;
    return b.time - a.time;
  });

  range.setValues(rows.map(row => row.values));
  sheet.getRange(firstDataRow, config.dateColumn, rows.length, 1).setNumberFormat("dd/MM/yyyy");
  if (config === LEAVE_FILTER) sheet.getRange(firstDataRow, 5, rows.length, 1).setNumberFormat("dd/MM/yyyy");
}

function ensureMonthlyRequestFilter_(sheet, table, config) {
  const existing = sheet.getFilter();
  if (existing) existing.remove();
  const filterColumnCount = config.filterColumnCount || config.columnCount;
  const dataRowCount = getContiguousDatedRowCount_(sheet, table, config.dateColumn);
  let rowCount = dataRowCount + 1;
  let filterRange = sheet.getRange(table.headerRow, 1, rowCount, filterColumnCount);
  const mergedRanges = filterRange.getMergedRanges();

  if (mergedRanges.length) {
    const firstMergedRow = Math.min.apply(null, mergedRanges.map(range => range.getRow()));
    rowCount = firstMergedRow - table.headerRow;
    if (rowCount < 1) throw new Error("Filter header contains merged cells in " + sheet.getName());
    filterRange = sheet.getRange(table.headerRow, 1, rowCount, filterColumnCount);
  }

  filterRange.createFilter();
}

function getContiguousDatedRowCount_(sheet, table, dateColumn) {
  const available = sheet.getLastRow() - table.headerRow;
  if (available <= 0) return 0;
  const dates = sheet.getRange(table.headerRow + 1, dateColumn, available, 1).getDisplayValues();
  let count = 0;
  for (let i = 0; i < dates.length; i++) {
    if (!parseDate(dates[i][0])) break;
    count++;
  }
  return count;
}

function columnToLetter_(column) {
  let result = "";
  let value = column;
  while (value > 0) {
    value--;
    result = String.fromCharCode(65 + (value % 26)) + result;
    value = Math.floor(value / 26);
  }
  return result;
}

function syncLeaveQuotaFromEdit(e) {
  try {
    const sheet = e && e.range && e.range.getSheet ? e.range.getSheet() : null;
    if (!sheet) return;
    if (sheet.getName() === SHEETS.leaves && e.range.getA1Notation() !== LEAVE_FILTER.selectorCell) {
