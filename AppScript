  const topRange = sheet.getRange(1, 1, headerRow, 9);
  topRange.breakApart().clearContent();
  if (regularSalarySheet) {
    regularSalarySheet.getRange(1, 1, headerRow, 9)
      .copyFormatToRange(sheet, 1, 9, 1, headerRow);
    regularSalarySheet.getRange(1, 1)
      .copyFormatToRange(sheet, 1, 9, 1, 1);
    for (let row = 1; row <= headerRow; row++) {
      sheet.setRowHeight(row, regularSalarySheet.getRowHeight(row));
    }
    for (let col = 1; col <= 8; col++) {
      sheet.setColumnWidth(col, regularSalarySheet.getColumnWidth(col));
    }
    sheet.setColumnWidth(9, regularSalarySheet.getColumnWidth(Math.min(12, regularSalarySheet.getMaxColumns())));
  } else {
    sheet.getRange(1, 1, 1, 9)
      .setBackground("#174E3B")
      .setFontColor("#FFFFFF")
      .setFontWeight("bold")
      .setHorizontalAlignment("center");
    sheet.getRange(headerRow, 1, 1, 9)
      .setBackground("#2D6A4F")
      .setFontColor("#FFFFFF")
      .setFontWeight("bold")
      .setHorizontalAlignment("center");
  }

  sheet.getRange(1, 1, 1, 9).merge()
    .setValue("💰 สรุปเงินเดือนพาร์ทไทม์ประจำเดือน")
