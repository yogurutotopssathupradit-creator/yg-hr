function setupCheckinMonthSelector_(sheet) {
  const options = [CHECKIN_FILTER.allLabel].concat(getCheckinMonthOptions_(sheet));
  const current = clean(sheet.getRange(CHECKIN_FILTER.selectorCell).getDisplayValue());
  const selected = options.indexOf(current) >= 0 ? current : getMonthPeriod(new Date()).label;

  sheet.getRange(CHECKIN_FILTER.labelCell)
    .setValue("เลือกเดือน")
    .setFontWeight("bold")
    .setBackground("#E6F4EA")
    .setFontColor("#174E3B");
  sheet.getRange(CHECKIN_FILTER.selectorCell)
    .setDataValidation(SpreadsheetApp.newDataValidation()
      .requireValueInList(options, true)
      .setAllowInvalid(false)
      .build())
    .setValue(selected)
    .setBackground("#E6F4EA")
    .setFontColor("#174E3B");
}

function refreshCheckinFilter_(sheet) {
  const selected = clean(sheet.getRange(CHECKIN_FILTER.selectorCell).getDisplayValue()) || CHECKIN_FILTER.allLabel;
  const table = getFlexibleTable(sheet, "วันที่");
  ensureCheckinFilter_(sheet, table);
  applyCheckinMonthFilter_(sheet, selected);
}

function applyCheckinMonthFilter_(sheet, selectedValue) {
  const selected = clean(selectedValue || sheet.getRange(CHECKIN_FILTER.selectorCell).getDisplayValue());
  const filter = sheet.getFilter();
  if (!filter) return;
  if (!selected || selected === CHECKIN_FILTER.allLabel) {
    filter.removeColumnFilterCriteria(1);
    return;
  }

  const period = parseThaiMonthLabel_(selected);
  if (!period) return;
  const table = getFlexibleTable(sheet, "วันที่");
  const firstDataRow = table.headerRow + 1;
  const formula = "=AND($A" + firstDataRow + ">=DATE(" + period.year + "," + period.month + ",1)," +
    "$A" + firstDataRow + "<DATE(" + period.nextYear + "," + period.nextMonth + ",1))";
  filter.setColumnFilterCriteria(1, SpreadsheetApp.newFilterCriteria()
    .whenFormulaSatisfied(formula)
    .build());
}

function getCheckinMonthOptions_(sheet) {
  const table = getFlexibleTable(sheet, "วันที่");
  const displayedDates = table.rows.length
    ? sheet.getRange(table.headerRow + 1, 1, table.rows.length, 1).getDisplayValues()
    : [];
  const months = {};
  displayedDates.forEach(row => {
    const date = parseDate(row[0]);
    if (!date) return;
    const key = Utilities.formatDate(date, TIMEZONE, "yyyy-MM");
    months[key] = getMonthPeriod(date).label;
  });
  const now = new Date();
  months[Utilities.formatDate(now, TIMEZONE, "yyyy-MM")] = getMonthPeriod(now).label;
  return Object.keys(months).sort().reverse().map(key => months[key]);
}

function parseThaiMonthLabel_(label) {
  const match = clean(label).match(/^(.+?)\s+(\d{4})$/);
  if (!match) return null;
  const month = THAI_MONTH_NAMES.indexOf(match[1]);
  const buddhistYear = Number(match[2]);
  if (month < 0 || !buddhistYear) return null;
  const year = buddhistYear - 543;
  const nextDate = new Date(year, month + 1, 1);
  return {
    year,
    month: month + 1,
    nextYear: nextDate.getFullYear(),
    nextMonth: nextDate.getMonth() + 1
  };
}

function sortCheckinRowsNewestFirst_(sheet, table) {
  const firstDataRow = table.headerRow + 1;
  const lastRow = sheet.getLastRow();
  if (lastRow < firstDataRow) return;

  const columnCount = 7;
  const range = sheet.getRange(firstDataRow, 1, lastRow - firstDataRow + 1, columnCount);
  const values = range.getValues();
  const displayValues = range.getDisplayValues();
  const dataRows = [];

  // Check-in records are contiguous. Stop before blank space or instruction rows
  // so those rows keep their original position below the table.
  for (let i = 0; i < values.length; i++) {
    if (!normalizeDateKey(displayValues[i][0])) break;
    const normalizedValues = values[i].slice();
    // Migrate legacy text/locale-dependent dates to an unambiguous Date value.
    normalizedValues[0] = parseDate(displayValues[i][0]) || values[i][0];
    dataRows.push({ values: normalizedValues, date: displayValues[i][0], time: displayValues[i][3] });
  }
  if (!dataRows.length) return;

  dataRows.sort((a, b) => {
    const dateCompare = normalizeDateKey(b.date).localeCompare(normalizeDateKey(a.date));
    if (dateCompare) return dateCompare;
    return timeSortValue_(b.time) - timeSortValue_(a.time);
  });

  sheet.getRange(firstDataRow, 1, dataRows.length, columnCount).setValues(dataRows.map(row => row.values));
  sheet.getRange(firstDataRow, 1, dataRows.length, 1).setNumberFormat("dd/MM/yyyy");
}

function timeSortValue_(value) {
  const text = toDisplayTime(value);
  const match = text.match(/^(\d{1,2}):(\d{2})/);
  if (!match) return -1;
  return Number(match[1]) * 60 + Number(match[2]);
}

function ensureCheckinFilter_(sheet, table) {
  const existing = sheet.getFilter();
  if (existing) existing.remove();
  const rowCount = Math.max(table.rows.length + 1, 2);
  sheet.getRange(table.headerRow, 1, rowCount, 7).createFilter();
}

